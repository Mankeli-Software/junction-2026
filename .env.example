# Copy to .env for local development. Never commit .env.
# The VM has no .env: its settings come from Azure Key Vault (#28).

# Local Postgres from deploy/docker-compose.dev.yml. Inside Compose the api container
# overrides this with the db service's address.
DATABASE_URL=postgresql+psycopg://junction:junction@localhost:5432/junction

# Only on the VM: migrations run with this admin URL while the app uses DATABASE_URL.
# Empty means migrations use DATABASE_URL too.
MIGRATION_DATABASE_URL=

# snapshot for tests and the stage demo, live only for a small shortlist.
VALIO_SOURCE=snapshot
VALIO_API_KEY=
GEMINI_API_KEY=

# Real SMS through Twilio stays off; messages go to the simulated inbox.
SMS_TWILIO_ENABLED=false
# Comma-separated E.164 numbers allowed to get a real SMS when the flag is on.
SMS_ALLOWLIST=

SESSION_SECRET=change-me

# Ed25519 key that signs quotes (PKCS#8 PEM, `\n` for line breaks). Empty: the API makes a
# key for each run, so quotes from an earlier run no longer verify. Make one with
# openssl genpkey -algorithm ed25519 | awk 'NF {printf "%s\\n", $0}'
QUOTE_SIGNING_KEY=

# Where the web app is served; confirmation links are <PUBLIC_BASE_URL>/c/<token>. Also the
# OAuth issuer, the /mcp resource URL and the login pages (#48). The SvelteKit dev server by
# default; http://localhost is the Compose stack; the VM sets https://simo.mankeli.co.
PUBLIC_BASE_URL=http://localhost:5173

# Where the confirmation page gets its data: fixture (in-memory, the default in pnpm dev) or
# api (the default in a build; Compose sets it). Set fixture to opt in outside pnpm dev.
CONFIRMATION_SOURCE=fixture
# Where the demo phone gets its account, inbox and voice relay: fixture (in-memory, with the
# mock relay on /voice/ws; the default in pnpm dev) or api (the default in a build; Compose
# sets it). Set fixture to opt in outside pnpm dev.
DEMO_SOURCE=fixture
# FastAPI for the web app when CONFIRMATION_SOURCE or DEMO_SOURCE is api. Compose sets http://api:8000.
API_BASE_URL=http://localhost:8000

# Without a session cookie or bearer token, act as the fixed demo customer (Hassu Hauki Oy).
# Tests and local dev only.
DEV_FAKE_CALLER=true

# false lets /mcp calls without a bearer token act as the demo customer, to try a connector
# with auth off. Defaults to true.
MCP_AUTH_REQUIRED=true

# The public dashboard shows and counts only sessions started at or after this time
# (ISO 8601 with an offset, for example 2026-11-14T09:00:00+02:00). Empty shows them all.
EVENT_START=

# dev or prod. prod makes the simo_session cookie Secure; the VM needs ENV=prod.
ENV=dev

# Azure Application Insights. Leave empty on a laptop; the VM reads it from Key Vault.
APPLICATIONINSIGHTS_CONNECTION_STRING=
