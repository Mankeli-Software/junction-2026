# Copy to .env for local development. Never commit .env.
# The VM has no .env: its settings come from Azure Key Vault (#28).

# Local Postgres from deploy/docker-compose.dev.yml. Inside Compose the api container
# overrides this with the db service's address.
DATABASE_URL=postgresql+psycopg://junction:junction@localhost:5432/junction

# snapshot for tests and the stage demo, live only for a small shortlist.
VALIO_SOURCE=snapshot
VALIO_API_KEY=
GEMINI_API_KEY=

# Real SMS through Twilio stays off; messages go to the simulated inbox.
SMS_TWILIO_ENABLED=false
# Comma-separated E.164 numbers allowed to get a real SMS when the flag is on.
SMS_ALLOWLIST=

SESSION_SECRET=change-me
