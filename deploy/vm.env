# Settings for the VM. None of these are secrets; the secrets are in Azure Key Vault.
# Use with: docker compose --env-file deploy/vm.env -f deploy/docker-compose.yml up -d --build
SITE_ADDRESS=simo.mankeli.co
ORIGIN=https://simo.mankeli.co
KEY_VAULT_URL=https://kv-simo-junction26.vault.azure.net/
PUBLIC_BASE_URL=https://simo.mankeli.co
ENV=prod
# Valio prices and stock (#31): record calls the API for each quote's shortlist and saves
# every response, building the stage snapshot set (#59). The directory is outside the repo;
# seed it once with data/snapshots.
VALIO_SOURCE=record
VALIO_SNAPSHOT_HOST_DIR=/home/azureuser/valio-snapshots
