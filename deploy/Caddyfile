# SITE_ADDRESS is ":80" on laptops (plain HTTP on http://localhost) and the domain on the VM,
# where Caddy fetches the certificate itself (technical-plan.md §10.2).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@api path /api/* /mcp /mcp/* /.well-known/* /oauth/* /voice/*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
