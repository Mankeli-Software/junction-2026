{
	"name": "junction-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"serve:mock": "node mock/serve.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test": "vitest run",
		"fixtures": "node scripts/generate-dashboard-fixtures.ts",
		"gen:api-types": "node scripts/generate-api-types.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26",
		"@types/qrcode": "^1.5.6",
		"@types/ws": "^8.18.2",
		"openapi-typescript": "^7.13.0",
		"qrcode": "^1.5.4",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0",
		"ws": "^8.23.0"
	},
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=24"
	}
}
