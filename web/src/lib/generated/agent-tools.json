[
	{
		"name": "search_products",
		"description": "Search the catalogue by text, claims and category; returns a shortlist with price and availability.",
		"inputSchema": {
			"$defs": {
				"Claim": {
					"description": "Product claims, from the product file's `nutritionalClaim` group.\n\nlactose_free is `LACTOSE FREE_FROM` only; `LACTOSE LOW` does not count.",
					"enum": [
						"lactose_free",
						"gluten_free",
						"vegan",
						"vegetarian"
					],
					"title": "Claim",
					"type": "string"
				}
			},
			"additionalProperties": false,
			"properties": {
				"q": {
					"title": "Q",
					"type": "string"
				},
				"claims": {
					"default": [],
					"items": {
						"$ref": "#/$defs/Claim"
					},
					"title": "Claims",
					"type": "array"
				},
				"category": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					],
					"default": null,
					"title": "Category"
				},
				"needed_by": {
					"anyOf": [
						{
							"format": "date",
							"type": "string"
						},
						{
							"type": "null"
						}
					],
					"default": null,
					"title": "Needed By"
				},
				"limit": {
					"default": 10,
					"maximum": 20,
					"minimum": 1,
					"title": "Limit",
					"type": "integer"
				}
			},
			"required": [
				"q"
			],
			"title": "search_productsArguments",
			"type": "object"
		},
		"rest": {
			"method": "GET",
			"path": "/api/v1/products"
		}
	},
